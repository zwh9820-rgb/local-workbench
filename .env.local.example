# ---------------------------------------------------------------------------
# 复制为 .env.local 后按需修改
# ---------------------------------------------------------------------------

# SQLite 数据库文件（相对项目根目录，或写绝对路径）
DATABASE_URL=./data/workbench.db

# LM Studio 本地 OpenAI 兼容接口（固定本机，不允许填云端地址）
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM Studio 不校验 key，但 OpenAI SDK 要求非空
LM_STUDIO_API_KEY=lm-studio

# 使用的 DeepSeek 系列模型 ID，需与 LM Studio 中已加载模型名称一致
# 可在「设置 - 模型」或 /v1/models 接口查看
LM_STUDIO_MODEL=deepseek-r1-distill-qwen-7b

# Agent 单轮最多循环次数（防止工具调用死循环）
AGENT_MAX_STEPS=6

# Agent 单次工具返回给模型的最大字符数
AGENT_TOOL_RESULT_LIMIT=4000

# 允许 Agent 读取的素材白名单目录（相对项目根，禁止改成项目外路径）
AI_MATERIAL_DIR=public/assets/ai-material
