# ============================================================
#  本地 AI 内容生产工作台 —— 环境变量示例
#  复制为 .env.local 后按需修改（.env.local 不要提交到 git）
# ============================================================

# ---------- 数据库（SQLite 本地文件） ----------
# 相对路径以项目根为基准；Tauri 打包后改成 AppData 绝对路径
DATABASE_URL=./data/workbench.db

# ---------- LM Studio（OpenAI 兼容接口） ----------
# 固定本地地址，不要写云端 key
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# 任意非空字符串即可，LM Studio 不校验
LM_STUDIO_API_KEY=lm-studio
# 必须选支持 function calling 的 DeepSeek 系列模型（在 LM Studio 里先加载好）
LM_STUDIO_MODEL=deepseek-r1-distill-qwen-7b
# Agent 单轮最大工具调用轮数（防止死循环）
AGENT_MAX_STEPS=8

# ---------- ComfyUI ----------
# 默认实例；设置页里可以再配置多实例并切换
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
# 单个任务最长等待时间（毫秒）
COMFYUI_TIMEOUT_MS=600000

# ---------- 备份导出 ----------
# 导出 zip 的临时目录
EXPORT_DIR=./data/exports
